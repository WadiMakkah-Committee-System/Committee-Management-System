# =====================================================================
# .env.production.example
# الهدف: قائمة الإعدادات المطلوبة لتشغيل النظام على خادم الإنتاج.
#
# طريقة الاستخدام (على الخادم فقط):
#   cp .env.production.example .env
#   nano .env        ثم تعبئة القيم
#
# تنبيهات:
# - لا تضع أي قيمة حقيقية في هذا الملف، فهو يُرفع على GitHub.
# - ملف .env الحقيقي يبقى على الخادم فقط، ولا يُرفع على GitHub أبداً.
# - DATABASE_URL وREDIS_URL وENVIRONMENT تُضبط تلقائياً من
#   docker-compose.prod.yml، فلا حاجة لكتابتها هنا.
# - استخدم في POSTGRES_PASSWORD حروفاً وأرقاماً فقط (بدون رموز)، لأنها
#   تدخل في رابط الاتصال بقاعدة البيانات.
# =====================================================================

# ---------- قاعدة البيانات ----------
POSTGRES_USER=committee
POSTGRES_PASSWORD=
POSTGRES_DB=committee_db

# ---------- المصادقة ----------
JWT_SECRET=
# مؤقت قبل التدشين: كلمة مرور أولية موحّدة للمستخدمين الجدد (مثل 123456).
# احذف القيمة (اتركه فارغًا) يوم التدشين ثم أعد تشغيل الباك-إند.
PRELAUNCH_INITIAL_PASSWORD=

# ---------- البريد الإلكتروني ----------
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ---------- تخزين الملفات ----------
# STORAGE_BACKEND: يبدأ على supabase، ثم يُغيَّر إلى local بعد نقل الملفات
# القديمة بالسكربت scripts/migrate_storage_to_local.py.
STORAGE_BACKEND=supabase
STORAGE_LOCAL_PATH=/app/storage
# تبقى بيانات Supabase مطلوبة حتى انتهاء نقل الملفات.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# ---------- الاجتماعات المرئية ----------
MEETING_PROVIDER=agora
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_ORGANIZER_EMAIL=
ACS_CONNECTION_STRING=

# ---------- تسجيل الدخول بحساب Microsoft ----------
MICROSOFT_LOGIN_ENABLED=false
MICROSOFT_LOGIN_DOMAINS=

# ---------- الذكاء الاصطناعي ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---------- النطاق ----------
# أثناء التجربة على عنوان IP: http://185.206.29.126
# بعد ربط النطاق: https://cms.wadimakkah.sa
CORS_ORIGINS=http://185.206.29.126
FRONTEND_URL=http://185.206.29.126
