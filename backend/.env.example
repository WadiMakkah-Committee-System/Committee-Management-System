# انسخ هذا الملف إلى .env وعبّئ القيم الفعلية محليًا فقط.
# لا تضع أي قيمة حقيقية هنا ولا تَرفع ملف .env نفسه إلى Git (مستثنى في .gitignore).

# --- Database ---
# مثال محلي (اختبارات): postgresql+asyncpg://postgres:postgres@localhost:5432/committee_db
# الإنتاج (Supabase): يُستخدم Session/Transaction Pooler أو الاتصال المباشر حسب بيئة النشر
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/committee_db

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
SESSION_IDLE_TIMEOUT_MINUTES=30

# --- Account lockout policy (FR-UM-019) ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- Email / SMTP (FR-UM-018) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# --- AI (مراحل لاحقة) ---
CLAUDE_API_KEY=

# --- عام ---
ENVIRONMENT=development
