# انسخ هذا الملف إلى .env وعبّئ القيم الفعلية محليًا فقط.
# لا تضع أي قيمة حقيقية هنا ولا تَرفع ملف .env نفسه إلى Git (مستثنى في .gitignore).

# --- Database ---
# مثال محلي (اختبارات): postgresql+asyncpg://postgres:postgres@localhost:5432/committee_db
# الإنتاج (Supabase): يُستخدم Session/Transaction Pooler أو الاتصال المباشر حسب بيئة النشر
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/committee_db

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
SESSION_IDLE_TIMEOUT_MINUTES=30

# --- Account lockout policy (FR-UM-019) ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- Email / SMTP (FR-UM-018 وإشعارات الاجتماعات) ---
# مثال Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com
# SMTP_PASSWORD يجب أن يكون App Password (وليس كلمة مرور حسابك العادية) —
# فعّلي "التحقق بخطوتين" بحساب Gmail أولًا، وبعدها أنشئي App Password من:
# https://myaccount.google.com/apppasswords
# مثال Outlook: SMTP_HOST=smtp.office365.com  SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=نظام إدارة اللجان
SMTP_USE_TLS=True

# --- AI (مراحل لاحقة) ---
CLAUDE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Supabase Storage (وحدة إدارة الوثائق) ---
# SUPABASE_URL: رابط مشروع Supabase (مثال: https://xxxx.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY: مفتاح Service Role — يتجاوز RLS، لذلك يبقى
# على الـ Backend فقط ولا يُرسَل أبدًا للعميل (Frontend).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
MAX_DOCUMENT_UPLOAD_MB=25

# --- عام ---
ENVIRONMENT=development
