# متغيرات البيئة المطلوبة لتشغيل النظام
# لا تضع أي قيمة فعلية هنا — هذا الملف للتوثيق فقط، القيم الحقيقية تبقى محليًا في ملف .env (المستثنى من Git)

# ==============================
# Database
# ==============================
DATABASE_URL=

# ==============================
# Authentication (JWT)
# ==============================
JWT_SECRET=

# ==============================
# الذكاء الاصطناعي
# ==============================
CLAUDE_API_KEY=

# ==============================
# البريد الإلكتروني (SMTP) — للإشعارات، دعوات الاجتماعات، استرجاع كلمة المرور (OTP)
# ==============================
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# ==============================
# Redis — لتتبع الجلسات النشطة وإبطال التوكن (Token Invalidation) عند تسجيل الخروج
# ==============================
REDIS_URL=
