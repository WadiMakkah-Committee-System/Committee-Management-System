# متغيرات البيئة المطلوبة لتشغيل النظام
# لا تضع أي قيمة فعلية هنا — هذا الملف للتوثيق فقط، القيم الحقيقية تبقى محليًا في ملف .env (المستثنى من Git)

# ==============================
# Database
# ==============================
DATABASE_URL=
# اختياري — مشغّل قاعدة البيانات (تحسين أداء 2026-10-28، راجعي backend/app/db/session.py):
# اتركيه فارغًا للاختيار التلقائي (psycopg). DB_DRIVER=asyncpg يرجّع المشغّل القديم فورًا.
DB_DRIVER=

# ==============================
# Authentication (JWT)
# ==============================
JWT_SECRET=

# ==============================
# الذكاء الاصطناعي
# ==============================
CLAUDE_API_KEY=

# ==============================
# البريد الإلكتروني (SMTP) — للإشعارات، دعوات الاجتماعات، استرجاع كلمة المرور (OTP)
# ==============================
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# smtp (الافتراضي) | resend | brevo — راجعي backend/.env.example
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
# رابط الواجهة (يظهر ببريد بيانات الدخول) — راجعي backend/.env.example
FRONTEND_URL=

# ==============================
# Redis — لتتبع الجلسات النشطة وإبطال التوكن (Token Invalidation) عند تسجيل الخروج
# ==============================
REDIS_URL=

# ==============================
# Supabase Storage — تخزين ملفات وحدة إدارة الوثائق (Service Role Key، لا يُشارك مع الـ Frontend)
# ==============================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
